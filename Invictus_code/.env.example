# Copy to `.env` and set to the backend base URL once APIs are available.
# While unset, admission applications are saved in the browser's localStorage (demo mode).
VITE_API_BASE_URL=https://api.example.com

# Demo admin login (frontend only — NOT secure; anything here ends up in the browser bundle).
# Leave unset to use the demo credentials shown on the login page.
# VITE_ADMIN_USERNAME=admin
# VITE_ADMIN_PASSWORD=change-me
